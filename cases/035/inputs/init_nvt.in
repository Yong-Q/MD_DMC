log __CASE_DIR__/logs/init.log
units real
boundary p p p
atom_style full
box tilt large
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

read_data __CASE_DIR__/system.data nocoeff
pair_style lj/cut/coul/long 12.0
pair_modify mix geometric
special_bonds lj/coul 0.0 0.0 0.5
bond_style harmonic
angle_style harmonic
dihedral_style opls
improper_style cvff
kspace_style pppm 1.0e-4

include __CASE_DIR__/inputs/forcefield_coeffs.in
group framework id 1:4176
group mobile subtract all framework
compute tmobile mobile temp
thermo_style custom step c_tmobile press pe ke etotal density atoms
thermo_modify temp tmobile flush yes
compute_modify thermo_temp dynamic/dof yes
variable stepv equal step
variable tempv equal c_tmobile
variable pressv equal press
variable pev equal pe
variable kev equal ke
variable etv equal etotal
variable rhov equal density
fix freeze framework setforce 0.0 0.0 0.0
velocity framework set 0.0 0.0 0.0
fix recenter mobile momentum 100 linear 1 1 1

min_style cg
minimize 1.0e-6 1.0e-8 5000 50000
timestep 0.250
velocity mobile create 298.0 886910233 dist gaussian mom yes rot yes
fix relax_limit mobile nve/limit 0.05
fix relax_lgvn mobile langevin 298.0 298.0 100.0 886910244 zero yes
fix thermo_relax_limit all print 1000 "${stepv},${tempv},${pressv},${pev},${kev},${etv},${rhov}" file __CASE_DIR__/logs/thermo_relax_limit.csv screen no title "step,temp_K,press_atm,pe,ke,etotal,density"
run 200000
unfix thermo_relax_limit
unfix relax_lgvn
unfix relax_limit
timestep 1.000
fix anneal_up_nve mobile nve
fix anneal_up_lgvn mobile langevin 298.0 400.0 100.0 886910254 zero yes
fix thermo_anneal_up all print 1000 "${stepv},${tempv},${pressv},${pev},${kev},${etv},${rhov}" file __CASE_DIR__/logs/thermo_anneal_up.csv screen no title "step,temp_K,press_atm,pe,ke,etotal,density"
run 300000
unfix thermo_anneal_up
unfix anneal_up_lgvn
unfix anneal_up_nve
fix anneal_hold_nve mobile nve
fix anneal_hold_lgvn mobile langevin 400.0 400.0 100.0 886910264 zero yes
fix thermo_anneal_hold all print 1000 "${stepv},${tempv},${pressv},${pev},${kev},${etv},${rhov}" file __CASE_DIR__/logs/thermo_anneal_hold.csv screen no title "step,temp_K,press_atm,pe,ke,etotal,density"
run 400000
unfix thermo_anneal_hold
unfix anneal_hold_lgvn
unfix anneal_hold_nve
fix anneal_down_nve mobile nve
fix anneal_down_lgvn mobile langevin 400.0 298.0 100.0 886910274 zero yes
fix thermo_anneal_down all print 1000 "${stepv},${tempv},${pressv},${pev},${kev},${etv},${rhov}" file __CASE_DIR__/logs/thermo_anneal_down.csv screen no title "step,temp_K,press_atm,pe,ke,etotal,density"
run 300000
unfix thermo_anneal_down
unfix anneal_down_lgvn
unfix anneal_down_nve
write_data __CASE_DIR__/state/equilibrated_nvt.data
dump traj all dcd 1000 __CASE_DIR__/traj/chunk_0001.dcd
restart 50000 __CASE_DIR__/state/autosave.*.bin
fix nvt_prod mobile nvt temp 298.0 298.0 100.0
fix thermo_prod all print 1000 "${stepv},${tempv},${pressv},${pev},${kev},${etv},${rhov}" file __CASE_DIR__/logs/thermo_chunk_0001.csv screen no title "step,temp_K,press_atm,pe,ke,etotal,density"
run 1000000
unfix thermo_prod
unfix nvt_prod
undump traj
write_restart __CASE_DIR__/state/restart_0001.bin
write_data __CASE_DIR__/state/data_0001.data
print "COMPLETED_CHUNK 1"
